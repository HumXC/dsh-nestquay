{
    "name": "dsh-nestquay",
    "version": "0.1.14",
    "type": "module",
    "description": "Workspace groups for the official DSH sidebar, preserving session and workspace services.",
    "license": "MIT",
    "exports": { ".": "./lib/host.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
    "files": ["lib", "cordis.patch.yml", "locale", "README.md", "LICENSE", "NOTICE", "assets/Twemoji.Mozilla.woff2", "assets/TWEMOJI-LICENSE.md"],
    "scripts": { "build": "node build.mjs", "test": "node --test test/*.test.mjs" },
    "dependencies": { "zod": "^4.4.3" },
    "devDependencies": { "typescript": "^5.9.3" },
    "engines": { "node": ">=22.15.0" },
    "peerDependencies": { "@deepseek-ai/dsh": "0.2.0-rc.2" },
    "dsh": {
        "bundle": { "patch": "./cordis.patch.yml" },
        "client": {
            "platform": "web",
            "immediately": true,
            "inject": ["@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-locale"],
            "external": ["@deepseek-ai/dsh-client-store", "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/cordis"]
        }
    }
}
